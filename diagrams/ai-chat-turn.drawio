<mxGraphModel adaptiveColors="auto" dx="1200" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="&lt;b&gt;AI 챗 한 턴: 사용량 게이트 → 에이전트 루프 → 판정 → 기록&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
      <mxGeometry x="40" y="-10" width="700" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="start" value="작가 질문" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="410" y="40" width="160" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="cap" value="오늘 사용량 ≥ 하루 한도?&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;350만 크레딧 ≈ 490원&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="360" y="120" width="260" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="r429" value="&lt;b&gt;429 거절&lt;/b&gt;&lt;br&gt;입력칸 자리에 쉬는 카드&lt;br&gt;한국 자정에 0%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="60" y="135" width="210" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="busy" value="이 작가의 다른 세션이&lt;br&gt;답을 쓰는 중?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="360" y="235" width="260" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="r409" value="&lt;b&gt;409 거절&lt;/b&gt;&lt;br&gt;작가당 동시 답 1개&lt;br&gt;(작가 단위 DB 잠금)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="60" y="250" width="210" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="prep" value="&lt;b&gt;컨텍스트 준비&lt;/b&gt;&lt;br&gt;지도: 전체 문서 제목·요약·관계&lt;br&gt;보유 문서: 이 세션에서 읽은 문서(현재 판)&lt;br&gt;이전 대화" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;" vertex="1" parent="1">
      <mxGeometry x="350" y="355" width="280" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="model" value="&lt;b&gt;응답 모델&lt;/b&gt;&lt;br&gt;gpt-6-luna · medium · 단계 n ≤ 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="360" y="465" width="260" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="choice" value="정렬? 답변?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="400" y="555" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="pack" value="&lt;b&gt;서버가 정렬 순서대로 문서 읽기&lt;/b&gt;&lt;br&gt;단계당 최대 4만 자 · id 최대 20개&lt;br&gt;못 담은 문서는 다음 단계에 다시 요청" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="690" y="560" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="judge" value="&lt;b&gt;판정 모델 2개 병렬&lt;/b&gt; (low)&lt;br&gt;충분성: 문서만으로 답이 서나 (AI 글은 안 봄)&lt;br&gt;답변 검사: 근거·인용·합리성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="340" y="670" width="300" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="pass" value="둘 다 통과?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="400" y="775" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="review" value="&lt;b&gt;리뷰를 응답 모델에 돌려줌&lt;/b&gt;&lt;br&gt;빠진 사실(missing) + 지적(problems)&lt;br&gt;→ 더 정렬하거나 고쳐 씀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="690" y="780" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="final" value="&lt;b&gt;마지막 답 +1&lt;/b&gt;&lt;br&gt;지적 반영, 판정 없이 전달&lt;br&gt;(근거 부족이면 그렇게 밝힘)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="60" y="785" width="210" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="deliver" value="작가에게 전달" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="410" y="895" width="160" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="record" value="&lt;b&gt;사용량 기록&lt;/b&gt; (턴이 끝날 때마다: 완료·실패·중단)&lt;br&gt;크레딧 = 입력 + 캐시×0.1 + 캐시쓰기×0.25 + 출력×5&lt;br&gt;작가·한국 날짜별 합계 → 다음 질문의 게이트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="320" y="980" width="340" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="note" value="&lt;b&gt;한도&lt;/b&gt;&lt;br&gt;응답 모델 호출 최대 4 + 1번&lt;br&gt;턴 시간 170초 (예비 75초 남으면 바로 마지막 답)&lt;br&gt;하루 한도 ≈ 490원 ≈ 평균 질문 80번&lt;br&gt;1크레딧 = 입력 토큰 $0.10/100만" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="690" y="900" width="260" height="110" as="geometry"/>
    </mxCell>
